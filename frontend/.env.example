VITE_API_URL=/api
# completo: todo simulado con MSW | parcial: MSW solo para inscripciones, diagnóstico e intentos | ninguno: backend real
VITE_API_MOCKS=ninguno
# Slug de la ruta que se muestra (con el seed de dev del backend: demo-atencion-cliente-remota)
VITE_RUTA_SLUG=atencion-al-cliente-remota
# Provisorio: usuario que firma los intentos (POST /api/intentos). Con el backend real tiene que ser un usuario existente.
VITE_USUARIO_ID=00000000-0000-4000-8000-000000000001
